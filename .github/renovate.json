{
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "docker": {
    "pinDigests": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "branch"
    }
  ],
  "assigneesFromCodeOwners": true,
  "baseBranches": ["main"]
}
